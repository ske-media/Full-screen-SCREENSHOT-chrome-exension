{
  "name": "full-page-capture",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Extension Chrome Manifest V3 pour capturer une page web entière, l'annoter et l'exporter.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-extension.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 43123"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.27.2",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
